#!/bin/bash
export PATH=/usr/bin:/usr/sbin:/bin:/sbin TERM=linux
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /run
mount -t securityfs securityfs /sys/kernel/security
mkdir -p /sys/firmware/efi/efivars
mount -t efivarfs efivarfs /sys/firmware/efi/efivars
state=$(od -An -tu1 -j4 -N1 /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c | tr -d ' \n')
echo "IMA_SB_STATE=$state"
case " $(cat /proc/cmdline) " in
    *' policy_test=second '*) echo IMA_SB_SECOND_KERNEL_BOOTED; poweroff -f; exit ;;
    *' policy_test=raw '*)
        if cat /etc/zbm-ima-policy > /sys/kernel/security/ima/policy; then
            echo IMA_SB_UNEXPECTED_RAW_ACCEPTANCE
        else
            echo IMA_SB_RAW_POLICY_REJECTED
        fi
        poweroff -f
        exit
        ;;
esac
# Exercise the production early hook, including its safe diagnostic failure path.
# shellcheck disable=SC1091
source /var/lib/dracut/hooks/pre-udev/05-zbm-ima-pre-udev.sh
[[ -f /etc/zbm-enforce ]] || exit 1
echo IMA_SB_SIGNED_POLICY_LOADED
signature=$(od -An -v -tx1 /fixtures/second.img.sig | tr -d ' \n')
cp /fixtures/second.img /run/second.img
setfattr -n security.ima -v "0x$signature" /run/second.img || exit 1
cp /run/second.img /run/unsigned.img
# cp does not retain security.ima by default.
if /usr/local/libexec/zbm-kexec-real -s -l /fixtures/kernel --initrd=/run/unsigned.img --append='console=ttyS0 policy_test=second'; then
    echo IMA_SB_UNEXPECTED_UNSIGNED_INITRAMFS
    poweroff -f
    exit 1
fi
echo IMA_SB_UNSIGNED_INITRAMFS_REJECTED
if /usr/local/libexec/zbm-kexec-real -c -l /fixtures/kernel --initrd=/run/second.img --append='console=ttyS0 policy_test=second'; then
    echo IMA_SB_UNEXPECTED_LEGACY_KEXEC
    poweroff -f
    exit 1
fi
echo IMA_SB_LEGACY_KEXEC_REJECTED
/usr/local/libexec/zbm-kexec-real -s -l /fixtures/kernel --initrd=/run/second.img --append='console=ttyS0 policy_test=second' || exit 1
echo IMA_SB_SIGNED_INITRAMFS_ACCEPTED
/usr/local/libexec/zbm-kexec-real -e || exit 1
