From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: okhsunrog <d3g3v3@gmail.com>
Date: Wed, 8 Jul 2026 00:00:00 +0000
Subject: [PATCH] drm/xe: Add modparam for rc6

Add an "enable_rc6" module parameter to the xe driver, mirroring the
behaviour of the i915 enable_rc6 modparam. When set to 0, both the
direct MMIO RC6 enable path used when GuC PC is skipped, and the
GuC-firmware-controlled RC6 path, are skipped. Default is enabled (1).

Rebased for the 7.1.x xe driver: the GuC RC6 control logic that used
to live in xe_guc_pc_start() has since been split out into its own
xe_guc_rc.c file (xe_guc_rc_enable()/xe_guc_rc_disable()), and the
DEFAULT_* macros moved from xe_module.c into xe_defaults.h. The
modparam check now lives in xe_guc_rc_enable(), which is the single
choke point for both the PVC, skip_guc_pc, and GuC-firmware-control
paths.

Useful for debugging GPU power management issues and for hardware where
RC6 misbehaves.

Signed-off-by: okhsunrog <d3g3v3@gmail.com>
---
diff --git a/drivers/gpu/drm/xe/xe_defaults.h b/drivers/gpu/drm/xe/xe_defaults.h
index c8ae1d5..11f1023 100644
--- a/drivers/gpu/drm/xe/xe_defaults.h
+++ b/drivers/gpu/drm/xe/xe_defaults.h
@@ -22,5 +22,6 @@
 #define XE_DEFAULT_WEDGED_MODE			XE_WEDGED_MODE_UPON_CRITICAL_ERROR
 #define XE_DEFAULT_WEDGED_MODE_STR		"upon-critical-error"
 #define XE_DEFAULT_SVM_NOTIFIER_SIZE		512
+#define XE_DEFAULT_ENABLE_RC6			true

 #endif
diff --git a/drivers/gpu/drm/xe/xe_gt_idle.c b/drivers/gpu/drm/xe/xe_gt_idle.c
index 4a2d9ed..5819dfd 100644
--- a/drivers/gpu/drm/xe/xe_gt_idle.c
+++ b/drivers/gpu/drm/xe/xe_gt_idle.c
@@ -14,6 +14,7 @@
 #include "xe_guc_pc.h"
 #include "regs/xe_gt_regs.h"
 #include "xe_mmio.h"
+#include "xe_module.h"
 #include "xe_pm.h"
 #include "xe_sriov.h"
 #include "xe_wa.h"
@@ -406,6 +407,13 @@ void xe_gt_idle_enable_c6(struct xe_gt *gt)
 	if (IS_SRIOV_VF(gt_to_xe(gt)))
 		return;

+	if (!xe_modparam.enable_rc6) {
+		/* Make sure RC6 stays disabled. */
+		xe_mmio_write32(&gt->mmio, RC_CONTROL, 0);
+		xe_mmio_write32(&gt->mmio, RC_STATE, 0);
+		return;
+	}
+
 	/* Units of 1280 ns for a total of 5s */
 	xe_mmio_write32(&gt->mmio, RC_IDLE_HYSTERSIS, 0x3B9ACA);
 	/* Enable RC6 */
diff --git a/drivers/gpu/drm/xe/xe_guc_rc.c b/drivers/gpu/drm/xe/xe_guc_rc.c
index 99fa127..09e04d8 100644
--- a/drivers/gpu/drm/xe/xe_guc_rc.c
+++ b/drivers/gpu/drm/xe/xe_guc_rc.c
@@ -15,6 +15,7 @@
 #include "xe_guc_ct.h"
 #include "xe_guc_pc.h"
 #include "xe_guc_rc.h"
+#include "xe_module.h"
 #include "xe_pm.h"

 /**
@@ -117,6 +118,12 @@ int xe_guc_rc_enable(struct xe_guc *guc)
 	if (!xe_force_wake_ref_has_domain(fw_ref.domains, XE_FW_GT))
 		return -ETIMEDOUT;

+	if (!xe_modparam.enable_rc6) {
+		/* Take RC6 control back from GuC and leave it disabled. */
+		xe_guc_rc_disable(guc);
+		return 0;
+	}
+
 	if (xe->info.platform == XE_PVC) {
 		xe_guc_rc_disable(guc);
 		return 0;
diff --git a/drivers/gpu/drm/xe/xe_module.c b/drivers/gpu/drm/xe/xe_module.c
index 4cb5781..4e451f6 100644
--- a/drivers/gpu/drm/xe/xe_module.c
+++ b/drivers/gpu/drm/xe/xe_module.c
@@ -29,6 +29,7 @@ struct xe_modparam xe_modparam = {
 #endif
 	.wedged_mode =		XE_DEFAULT_WEDGED_MODE,
 	.svm_notifier_size =	XE_DEFAULT_SVM_NOTIFIER_SIZE,
+	.enable_rc6 =		XE_DEFAULT_ENABLE_RC6,
 	/* the rest are 0 by default */
 };

@@ -83,6 +84,11 @@ MODULE_PARM_DESC(wedged_mode,
 		 "Module's default policy for the wedged mode (0=never, 1=upon-critical-error, 2=upon-any-hang-no-reset "
 		 "[default=" XE_DEFAULT_WEDGED_MODE_STR "])");

+module_param_named_unsafe(enable_rc6, xe_modparam.enable_rc6, bool, 0400);
+MODULE_PARM_DESC(enable_rc6,
+		 "Enable RC6 power saving (1=enable, 0=disable) "
+		 "[default=" __stringify(XE_DEFAULT_ENABLE_RC6) "])");
+
 static int xe_check_nomodeset(void)
 {
 	if (drm_firmware_drivers_only())
diff --git a/drivers/gpu/drm/xe/xe_module.h b/drivers/gpu/drm/xe/xe_module.h
index 79cb963..c748dc6 100644
--- a/drivers/gpu/drm/xe/xe_module.h
+++ b/drivers/gpu/drm/xe/xe_module.h
@@ -23,6 +23,7 @@ struct xe_modparam {
 #endif
 	unsigned int wedged_mode;
 	u32 svm_notifier_size;
+	bool enable_rc6;
 };

 extern struct xe_modparam xe_modparam;
--
2.47.0
