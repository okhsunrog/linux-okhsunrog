#!/bin/bash
# Build and verify a signed image off the ESP before replacing the boot image.
set -euo pipefail
exec 8>/run/lock/zbm-update.lock
flock 8
/usr/local/sbin/zbm-sign-boot
generate-zbm -c /etc/zfsbootmenu/staging.yaml
source_image=/var/lib/zbm-secureboot/staging/zfsbootmenu.EFI
/usr/local/sbin/zbm-sign-image "$source_image"
was_mounted=0
if mountpoint -q /mnt/efi; then was_mounted=1; else mount /mnt/efi; fi
cleanup() { if ((was_mounted == 0)); then umount /mnt/efi; fi; }
trap cleanup EXIT
dest=/mnt/efi/EFI/ZBM/zfsbootmenu.EFI
[[ $(findmnt -n -o UUID -T /mnt/efi) == 05E8-D496 ]] || exit 1
[[ -f $dest ]] && cp "$dest" "${dest%.EFI}-backup.EFI"
install -m 644 "$source_image" "${dest}.new"
sbverify --cert /var/lib/sbctl/keys/db/db.pem "${dest}.new"
sync -f "${dest}.new"
mv "${dest}.new" "$dest"
sync -f "$dest"
echo 'Signed ZFSBootMenu installed; check verification mode after reboot.'
