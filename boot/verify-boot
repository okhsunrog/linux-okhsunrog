#!/bin/bash
set -euo pipefail
[[ $# == 4 ]] || { echo 'usage: verify-boot KERNEL INITRAMFS CMDLINE PUBLIC_KEY' >&2; exit 2; }
kernel=$1 initramfs=$2 cmdline=$3 public_key=$4
# The audit ID is generated by the boot wrapper, not part of the signed policy.
if [[ $cmdline =~ \ zbm\.audit_id=([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$ ]]; then
    cmdline=${cmdline% zbm.audit_id=*}
fi
[[ $cmdline != *zbm.audit_id=* ]] || exit 1
policy="${kernel}.zbm-policy"
signature="${policy}.sig"
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
cat "$policy" > "$tmp"
openssl dgst -sha256 -verify "$public_key" -signature "$signature" "$tmp" >/dev/null
mapfile -t fields < "$tmp"
[[ ${#fields[@]} == 5 && ${fields[0]} == ZBM-POLICY-v1 ]] || exit 1
[[ ${fields[1]} =~ ^[0-9a-f]{64}$ && ${fields[2]} =~ ^[0-9a-f]{64}$ ]] || exit 1
[[ ${fields[3]} == root=ZFS=novafs/ ]] || exit 1
actual=$(sha256sum -- "$kernel"); [[ ${actual%% *} == "${fields[1]}" ]] || exit 1
actual=$(sha256sum -- "$initramfs"); [[ ${actual%% *} == "${fields[2]}" ]] || exit 1
[[ $cmdline == *' '* ]] || exit 1
root_arg=${cmdline%% *}
[[ $root_arg == "${fields[3]}"* && $root_arg =~ ^root=ZFS=[a-zA-Z0-9_./:@-]+$ ]] || exit 1
[[ ${cmdline#* } == "${fields[4]}" ]] || exit 1
echo 'ZBM policy signature, kernel, initramfs and command line verified'
